{
  "name": "采购自动化台账",
  "description": "采购自动化：建采购台账（8 列 6 行）-> 按供应商汇总金额 -> 筛出待交付明细 -> 导出「待交付采购明细.xlsx」。全程只用确定性文档工具，不需要模型、不占显卡。",
  "steps": [
    {
      "id": "s1",
      "tool": "create_sheet",
      "args": {
        "name": "采购台账.xlsx",
        "sheet": "采购台账",
        "out_dir": "E:\\lora test pdf url",
        "headers": [
          "采购单号",
          "物品名称",
          "供应商",
          "数量",
          "单价",
          "金额",
          "交期",
          "状态"
        ],
        "rows": [
          [
            "CG2026-001",
            "A4 复印纸",
            "晨光文具",
            50,
            22.5,
            1125,
            "2026-10-20",
            "待交付"
          ],
          [
            "CG2026-002",
            "硒鼓 CF218A",
            "惠普耗材",
            10,
            380,
            3800,
            "2026-10-18",
            "已交付"
          ],
          [
            "CG2026-003",
            "键盘 K380",
            "罗技旗舰店",
            15,
            199,
            2985,
            "2026-10-25",
            "待交付"
          ],
          [
            "CG2026-004",
            "A4 复印纸",
            "晨光文具",
            80,
            22.5,
            1800,
            "2026-11-05",
            "待交付"
          ],
          [
            "CG2026-005",
            "移动硬盘 2TB",
            "西部数据",
            5,
            559,
            2795,
            "2026-10-30",
            "已交付"
          ],
          [
            "CG2026-006",
            "硒鼓 CF218A",
            "惠普耗材",
            6,
            380,
            2280,
            "2026-11-08",
            "待交付"
          ]
        ]
      },
      "x": 24,
      "y": 24
    },
    {
      "id": "s2",
      "tool": "group_sum",
      "args": {
        "filename": "{{steps.0.filename}}",
        "sheet": "采购台账",
        "group_by": "供应商",
        "sum_column": "金额"
      },
      "x": 244,
      "y": 24
    },
    {
      "id": "s3",
      "tool": "filter_rows",
      "args": {
        "filename": "{{steps.0.filename}}",
        "sheet": "采购台账",
        "column": "状态",
        "op": "==",
        "value": "待交付",
        "limit": 100
      },
      "x": 464,
      "y": 24
    },
    {
      "id": "s4",
      "tool": "write_sheet",
      "args": {
        "name": "待交付采购明细.xlsx",
        "sheet": "待交付",
        "out_dir": "E:\\lora test pdf url",
        "header": "{{steps.2.header}}",
        "rows": "{{steps.2.rows}}"
      },
      "x": 24,
      "y": 104
    },
    {
      "tool": "logic_check",
      "args": {
        "text": "{{steps.3.text}}"
      },
      "x": 470,
      "y": 150
    }
  ]
}