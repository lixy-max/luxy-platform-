# 复制为 .env（.env 已被 .gitignore 忽略）
# ★ 密钥只放这里，不要写进 settings.json 提交到 git

# 云端（可选）：学习增强 / 能力不足时接管
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 端口
BACKEND_PORT=8001
WEB_PORT=8080

# GPU 策略：auto（单卡自动）/ dual（训练 GPU0 · 推理 GPU1）
GPU_MODE=auto

# 浏览器 sidecar（可选）
# BROWSER_SIDECAR=http://127.0.0.1:9224
# BROWSER_SIDECAR_TOKEN=
